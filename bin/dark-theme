#!/usr/bin/bash

# ghostty theme
sed -i 's|Catppuccin Latte|Catppuccin Mocha|' ~/.config/ghostty/auto/theme.ghostty

# nvim theme
cd ~/.config/nvim/lua/plugins/ui/
sed -i 's|latte|mocha|' colorscheme.lua

# waybar theme
cp ~/.config/waybar/colors-mocha.css ~/.config/waybar/colors.css
swaymsg reload
# rofi
cd ~/.config/rofi/themes/
sed -i 's|background: #EFF1F5|background: #181825|' colors.rasi
sed -i 's|prompt: #cdd6f4|prompt: #1e1e2e|' colors.rasi
sed -i 's|text: #45475a|text: #cdd6f4|' colors.rasi
sed -i 's|select: #cdd6f4|select: #1e1e2e|' colors.rasi

# swaync
cp ~/.config/swaync/catppuccin-mocha.css ~/.config/swaync/style.css && swaync-client --reload-css

# Global Theme
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
