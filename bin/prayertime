#!/usr/bin/env bash

set -euo pipefail

# ==========================================
# Prayer Times - Amman, Jordan
# ==========================================

latitude=31.9454
longitude=35.9284
method=1

RED='\033[0;31m'
NC='\033[0m'

# Check dependencies
command -v curl >/dev/null 2>&1 || {
    echo "Error: curl is not installed."
    exit 1
}

command -v jq >/dev/null 2>&1 || {
    echo "Error: jq is not installed."
    exit 1
}

# API URL
api_url="https://api.aladhan.com/v1/timings/now?latitude=${latitude}&longitude=${longitude}&method=${method}"

# Fetch prayer times
response=$(curl -fsS "$api_url") || {
    echo "Error: Failed to fetch prayer times."
    exit 1
}

# Verify API response status
status=$(jq -r '.status // empty' <<< "$response")

if [[ "$status" != "OK" ]]; then
    echo "Error: Invalid API response."
    jq . <<< "$response"
    exit 1
fi

# Extract prayer times with a single jq call
read -r fajr dhuhr asr maghrib isha < <(
    jq -r '
        .data.timings
        | [.Fajr, .Dhuhr, .Asr, .Maghrib, .Isha]
        | @tsv
    ' <<< "$response"
)

# Header
printf "%b\n" "${RED}                                     __  _             ${NC}"
printf "%b\n" "${RED}   ___  _______ ___ _____ _______   / /_(_)_ _  ___ ___${NC}"
printf "%b\n" "${RED}  / _ \\/ __/ _ \`/ // / -_) __(_-<  / __/ /  ' \\/ -_|_-<${NC}"
printf "%b\n" "${RED} / .__/_/  \\_,_/\\_, /\\__/_/ /___/  \\__/_/_/_/_/\\__/___/${NC}"
printf "%b\n" "${RED}/_/            /___/                                   ${NC}"

printf "%b\n" "${RED}-----------------------------------${NC}"
printf "%-10s | %-10s\n" "Prayer" "Time"
printf "%b\n" "${RED}-----------------------------------${NC}"

printf "%-10s | %-10s\n" "Fajr"     "$fajr"
printf "%-10s | %-10s\n" "Dhuhr"    "$dhuhr"
printf "%-10s | %-10s\n" "Asr"      "$asr"
printf "%-10s | %-10s\n" "Maghrib"  "$maghrib"
printf "%-10s | %-10s\n" "Isha"     "$isha"

printf "%b\n" "${RED}-----------------------------------${NC}"
