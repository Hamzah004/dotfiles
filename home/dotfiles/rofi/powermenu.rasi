@import "./themes/colors.rasi"
* {
  background-color: transparent;
  text-color: @text;
  margin: 4;
  padding: 0;
}

window {
  location: center;
  anchor: center;
  fullscreen: false;
  height: 12%;
  enabled: true;
  border: 0px solid;
  border-color: transparent;
  background-color: @background;
}

inputbar {
  enabled: false;
}

listview {
  enabled: true;
  row: 1;
  lines: 5;
  cycle: true;
  dynamic: true;
  scrollbar: false;
  layout: horizontal;
  reverse: false;
  cursor: "default";

}
